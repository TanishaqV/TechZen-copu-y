# ---------------------------------------------------------------------------
# TechZen backend configuration
# Copy to .env and fill in. .env is gitignored - never commit real values.
# ---------------------------------------------------------------------------

# Postgres / Supabase connection string.
# Without this the API returns 501 and the frontend falls back to local demo
# data, so the site still renders but nothing is persisted.
#
# IMPORTANT for Vercel: use the CONNECTION POOLER, not the direct connection.
# Supabase's direct host (db.<project-ref>.supabase.co) resolves to IPv6 only,
# and Vercel functions have no IPv6 route, so it will fail to connect.
#
#   Vercel / serverless (Supavisor, transaction mode, IPv4):
#   DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
#   Local development (direct connection is fine if your network has IPv6):
#   DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
#
# Find both under: Supabase -> Project Settings -> Database -> Connection string
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Comma-separated admin accounts. These may post and delete events and read the
# full registration roster. Defaults to the three TechZen owner accounts.
ADMIN_EMAILS=you@example.com,cofounder@example.com

# Local API port (default 3001). vite.config.js proxies /api here in dev.
PORT=3001

# Extra browser origin allowed through CORS (optional). Same-origin requests and
# *.vercel.app deployments are already allowed.
CLIENT_ORIGIN=http://localhost:3000

# Frontend build-time values (Vite only exposes VITE_-prefixed vars)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxx
